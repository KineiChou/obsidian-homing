{
  "name": "obsidian-note-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "Quiet, confirmation-based filing and link suggestions for Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/common": "1.5.2",
    "@types/node": "22.20.4",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "obsidian": "1.11.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.1.7",
    "vitest": "4.0.18"
  }
}
