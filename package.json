{
  "name": "obsidian-homing",
  "version": "0.2.5",
  "private": true,
  "description": "File inbox notes into existing folders and link mentions to the right notes, with your confirmation, right in the editor.",
  "author": "KineiChou",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs",
    "benchmark": "node benchmarks/metadata-index.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:obsidian && npm test && npm run build",
    "benchmark:links": "node --expose-gc benchmarks/link-scan.mjs",
    "lint:obsidian": "eslint -c eslint.obsidian.config.mjs src"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/common": "1.5.2",
    "@types/node": "22.20.4",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "26.1.0",
    "obsidian": "1.11.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
